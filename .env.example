# Copy to .env and .env.local. Prisma CLI reads .env. Next.js reads .env.local.
# Use the same values locally. Neither file is committed.

# Local Postgres
DATABASE_URL="postgresql://scott@localhost:5432/edctox?schema=public"
DIRECT_URL="postgresql://scott@localhost:5432/edctox?schema=public"

# Server-only. Leave empty until you have a CompTox CTX key. Never use a NEXT_PUBLIC_ name.
# EPA_CTX_API_KEY=""

# Optional. Literature search works without these, at the public NCBI rate.
# NCBI_API_KEY=""
# NCBI_EMAIL=""

# Supabase: runtime pooler (port 6543) and direct connection (port 5432) for migrations.
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"
